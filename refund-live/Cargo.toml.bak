[package]
name        = "refund-live"
version     = "0.1.0"
edition     = "2021"
description = "Live API experiment runners for the Token Budgets receipt/refund cycle, A1 validation, multi-turn workloads, reasoning-model evaluation, ReAct demo, and estimator comparison."

# Standalone workspace; does not inherit a parent
[workspace]

[dependencies]
# Upstream library (FIXED PATH: up two levels to sibling repo)
token-budgets = { path = "../../token-budgets" }

# HTTP / async runtime
reqwest = { version = "0.12", features = ["json"] }
tokio   = { version = "1", features = ["full"] }

# Serialization
serde      = { version = "1", features = ["derive"] }
serde_json = "1"
csv        = "1"

# CLI parsing
clap = { version = "4", features = ["derive"] }

# Error handling
anyhow = "1"

[features]
default  = []
tiktoken = ["token-budgets/tiktoken"]

# ── 10 binary targets (one per experiment runner) ──
[[bin]]
name = "a1-adversarial"
path = "src/bin/a1-adversarial.rs"

[[bin]]
name = "a1-adversarial-n100"
path = "src/bin/a1-adversarial-n100.rs"

[[bin]]
name = "a1-rerun"
path = "src/bin/a1-rerun.rs"

[[bin]]
name = "compare-estimators"
path = "src/bin/compare-estimators.rs"

[[bin]]
name = "compare-estimators-openai"
path = "src/bin/compare-estimators-openai.rs"

[[bin]]
name = "multi-turn-session"
path = "src/bin/multi-turn-session.rs"

[[bin]]
name = "react-agent-bench"
path = "src/bin/react-agent-bench.rs"

[[bin]]
name = "reasoning-eval"
path = "src/bin/reasoning-eval.rs"

[[bin]]
name = "refund-live-1000"
path = "src/bin/refund-live-1000.rs"

[[bin]]
name = "refund-live-multi"
path = "src/bin/refund-live-multi.rs"

# NOTE: No [[bin]] entry for main.rs (file was deleted; functionality
# subsumed by refund-live-1000 and refund-live-multi).
# NOTE: src/lib.rs is auto-detected by Cargo — no [lib] entry needed.

[profile.release]
opt-level = 3
lto       = "thin"